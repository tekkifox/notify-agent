# Copy this file to stack.env, fill in real values, then:
#   chmod 600 stack.env
# stack.env is gitignored and must never be committed or baked into the image.

# Delivery: Discord incoming webhook URL.
# When set, notify.sh uses Discord and ignores the Composio settings below.
# Format: https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=

# Delivery: Composio fallback. Used only when DISCORD_WEBHOOK_URL is empty.
# Both COMPOSIO_API_KEY and COMPOSIO_TOOL are required for this path.
# Targets the Discord Bot toolkit, for example:
#   COMPOSIO_TOOL=DISCORDBOT_CREATE_MESSAGE
COMPOSIO_API_KEY=
# Composio tool slug to execute.
COMPOSIO_TOOL=

# Composio connected-account user id. Leave empty for "default".
COMPOSIO_USER_ID=

# Tool argument that receives the message. Leave empty for "content".
COMPOSIO_MESSAGE_FIELD=

# Extra tool arguments as a JSON object, merged into "arguments".
# DISCORDBOT_CREATE_MESSAGE needs the target channel, for example:
#   COMPOSIO_ARGS='{"channel_id":"123456789012345678"}'
# If a key collides with COMPOSIO_MESSAGE_FIELD, the message wins.
COMPOSIO_ARGS=

# Connected account to execute the tool against. Leave empty to let Composio
# choose by user id. Set this when one user id has several connections for the
# same toolkit (for example two Discord bot connections, one per server): it is
# what disambiguates them.
COMPOSIO_CONNECTED_ACCOUNT_ID=

# Composio API base. Leave empty for https://backend.composio.dev.
COMPOSIO_API_BASE=

# LLM used by run-prompt.sh, in provider/model form.
# Required for scheduled prompts; run-prompt.sh refuses to start without it.
OPENCODE_MODEL=

# IANA timezone used by supercronic for the crontab. Defaults to UTC.
TZ=UTC
