# Environment template for notify-agent.
#
# The deployed setup is a Portainer stack: enter these as the stack's
# environment variables in the Portainer UI, not as a file inside the container.
# For a plain `docker compose` run, stack.env is still the path: copy this file
# to stack.env and fill in real values, then:
#   chmod 600 stack.env
# stack.env is gitignored and must never be committed or baked into the image.
# This template contains the documented example channel and account ids that
# are already public in the README; it must never contain API keys, webhook
# URLs, Oracle credentials, author allowlists or any other secret.

# Delivery: Discord incoming webhook URL. When set, Discord is used and the
# Composio settings below are ignored. Must be an https:// URL.
DISCORD_WEBHOOK_URL=

# Delivery fallback: Composio. Used only when DISCORD_WEBHOOK_URL is empty.
# Both COMPOSIO_API_KEY and COMPOSIO_TOOL are required for this path.
COMPOSIO_API_KEY=

# Composio tool slug to execute, for example DISCORDBOT_CREATE_MESSAGE.
COMPOSIO_TOOL=

# Composio connected-account user id. Leave empty for "default".
COMPOSIO_USER_ID=

# Tool argument that receives the message. Leave empty for "content".
COMPOSIO_MESSAGE_FIELD=

# Extra Composio tool arguments as one-line JSON, merged into "arguments".
# Leave empty for none. A named target overrides channel_id and
# connected_account_id; the message field always wins a collision.
COMPOSIO_ARGS=

# Connected account to execute the tool against. Leave empty to let Composio
# choose by user id. Set this when one user id has several connections for the
# same toolkit (for example two Discord bot connections, one per server): it is
# what disambiguates them. A named target overrides this value.
COMPOSIO_CONNECTED_ACCOUNT_ID=

# Composio API base. Leave empty for https://backend.composio.dev.
COMPOSIO_API_BASE=

# Named targets: an allowlist a schedule can refer to by name with
# `run-prompt.sh -t <name>` / `notify.sh -t <name>`. This is the only way a
# schedule chooses a destination; the model never sees or picks a channel id.
# Values need a channel_id and may pin the connected_account_id for that server.
# Keep the JSON on one line; every entry requires a channel_id.
#
# Optional per-target guards:
#   host_scope     the host (or list of hosts) a message to that target may
#                  talk about. Absent means no restriction. The guard is
#                  enforced in notify.sh: if the message body names a host
#                  outside this list (or its subdomains), the send fails
#                  non-zero and nothing is delivered. Entries cover themselves
#                  and their subdomains.
#   allow_content  boolean, default true. Set false to forbid the content
#                  search tool entirely: the target may see host statistics
#                  from NOTIFY_RO.HOST_STATS_V only, and nothing about the
#                  captain's site, CV, projects or pages.
# A malformed host_scope or allow_content value fails before anything is sent.
# The boundary is the destination, not the host: `admin-chat` is the Vortex
# server's channel, so it permits only Vortex hosts. `automations` is
# TekkiFox's Automations, so it permits the rossmoney hosts (and Vortex hosts).
# A rossmoney hostname, or a figure attributable to one, must never reach
# admin-chat. Both targets below are placeholders.
#   NOTIFY_TARGETS='{"automations":{"channel_id":"000000000000000000","connected_account_id":"00000000-0000-0000-0000-000000000000","host_scope":["host1.example.com","host2.example.com","host3.example.com"]},"admin-chat":{"channel_id":"111111111111111111","connected_account_id":"11111111-1111-1111-1111-111111111111","host_scope":["host3.example.com"],"allow_content":false}}'
NOTIFY_TARGETS=

# Target name used when a schedule does not pass -t. It must exist in
# NOTIFY_TARGETS. Leave empty to keep the legacy shape: COMPOSIO_ARGS plus
# COMPOSIO_CONNECTED_ACCOUNT_ID, with no target lookup. Named targets cannot be
# combined with DISCORD_WEBHOOK_URL.
NOTIFY_DEFAULT_TARGET=

# Inbound Discord replies. When NOTIFY_INBOUND_CHANNEL_ID or
# NOTIFY_INBOUND_SOURCES is set, the container also runs
# scripts/discord_inbound.py. It polls the configured channels with Composio
# tool execution (DISCORDBOT_LIST_MESSAGES) using COMPOSIO_API_KEY and a
# Discord *Bot* connection, then runs the notify agent for accepted messages.
# Leave both empty to keep the container output-only.
#
# Proxy execution does not work here: Composio returns "Proxy execute is not
# supported for toolkit discordbot". The bot toolkit must be executed as a
# tool. The read tool and its channel/account are chosen by the listener, not
# by the model.
#
# Each bot connection needs View Channel and Read Message History in the
# channel it reads; the reply path needs Send Messages. No new credential is
# required beyond the Composio account.
#
# Authorisation is default-deny. NOTIFY_INBOUND_ALLOWED_AUTHORS is a
# comma-separated allowlist of Discord *user ids* (not usernames). In
# single-channel mode it is required. In sources mode each source may override
# it; a source with neither refuses to start. Bots, webhook messages, other
# channels, duplicates, mentions-only messages and over-long messages are
# refused. The message body of a refused message is never logged.

# Single-channel mode, kept unchanged for existing deployments. Use this OR
# the sources array below, not both. NOTIFY_INBOUND_TARGET is the named
# NOTIFY_TARGETS entry used to send the answer back; its channel_id must equal
# NOTIFY_INBOUND_CHANNEL_ID, and its host_scope/allow_content guards apply to
# the inbound run.
NOTIFY_INBOUND_CHANNEL_ID=
NOTIFY_INBOUND_ALLOWED_AUTHORS=
NOTIFY_INBOUND_TARGET=

# Optional in single-channel mode: pin the read connection. It must match the
# inbound target's connected_account_id when both are set. Leave empty to use
# the target's account, then COMPOSIO_CONNECTED_ACCOUNT_ID, then the Composio
# project default. In sources mode each entry has its own account and this
# value is not used.
NOTIFY_INBOUND_CONNECTED_ACCOUNT_ID=

# Multi-source mode. A JSON array; each entry needs a unique name, its own
# connected_account_id and channel_id, and optionally allowed_authors and a
# reply target. Every source gets its own cursor and dedupe file, so one
# server cannot advance another's cursor.
#
# Reply routing: if `target` is set, notify.sh sends through that named
# NOTIFY_TARGETS entry (which must exist and match the source's channel and
# account; COMPOSIO_TOOL is required for this path). If `target` is omitted,
# the listener pins notify.sh to the source's bot connection and channel and
# sends with DISCORDBOT_CREATE_MESSAGE.
#
# Example: the Vortex Game Servers #admin-chat target and an Automations
# #general source that replies through its bot. These are the documented bot
# connections, not secrets. `allowed_authors` overrides the global list for
# one source; omit it to inherit NOTIFY_INBOUND_ALLOWED_AUTHORS.
#
# The other Automations channels are added the same way, by channel id:
#   #sonarr 000000000000000000
#   #seerr  000000000000000000
#   #radarr 000000000000000000
# Use their own source names, for example "automations-sonarr".
#
# NOTIFY_INBOUND_SOURCES='[
#   {"name":"vortex-admin","connected_account_id":"ca_EXAMPLECONNECTION","channel_id":"000000000000000000","target":"admin-chat"},
#   {"name":"automations-general","connected_account_id":"ca_EXAMPLECONNECTION","channel_id":"000000000000000000","allowed_authors":"222222222222222222"}
# ]'
NOTIFY_INBOUND_SOURCES=

# Optional tuning. Defaults shown.
# Poll interval in seconds, minimum 5. Discord's REST limit is generous; 30s
# is a calm default for an admin channel.
NOTIFY_INBOUND_POLL_SECONDS=30

# Maximum instruction length after mention removal. Longer messages are
# refused, never truncated. Discord's own message limit is 2,000 characters.
NOTIFY_INBOUND_MAX_INSTRUCTION_CHARS=1000

# Bounded queue. One agent runs at a time; messages beyond this many waiting
# are dropped and logged (still recorded, so they are never replayed).
NOTIFY_INBOUND_QUEUE_SIZE=4

# Hard timeout for one agent run, in seconds. The child process group is
# terminated if it is exceeded.
NOTIFY_INBOUND_RUN_TIMEOUT_SECONDS=300

# Durable baseline and dedupe file. It must be on a writable, persistent path.
# The default is inside the opencode-data named volume. Do not point it at the
# tmpfs state directory, or a container restart would lose the baseline.
NOTIFY_INBOUND_STATE_FILE=/home/agent/.local/share/opencode/discord-inbound-state.json

# Optional deep provider logging for one debugging run. When set to 1,
# opencode run gets --print-logs --log-level debug and the debug transcript
# becomes very verbose (the 256 KiB cap is reached quickly). Unset normally.
NOTIFY_DEBUG_LLM=

# LLM used by run-prompt.sh and the inbound listener, in provider/model form.
# Required for scheduled prompts and inbound replies; both refuse to start
# without it.
OPENCODE_MODEL=

# Oracle read-only access. These are consumed by the local MCP server in
# mcp/oracle_query.py, which the notify agent may call for host statistics
# (query) and published content search (search_content).
# The database user needs SELECT on NOTIFY_RO.HOST_STATS_V,
# ROSSMONEY."host-samples", ROSSMONEY."archview-sources" and
# ROSSMONEY.CONTENT_EMBEDDINGS, plus EXECUTE on ADMIN.EMBED_TEXT. It must not
# be able to read or write any other CMS table.
ORACLE_USER=
ORACLE_PASSWORD=
# Easy Connect or TNS alias from the wallet, for example
# mydb_high. Never put a full connect descriptor or password here.
ORACLE_DSN=

# In-container path of the read-only wallet mount. compose.yaml sets this to
# /wallet; the host directory is ORACLE_WALLET_HOST_DIR (compose interpolation,
# not this file). Wallet files are never baked into the image or committed.
ORACLE_WALLET_DIR=/wallet

# ---------------------------------------------------------------------------
# SSH health probe (separate section: #20 owns the inbound settings above)
# ---------------------------------------------------------------------------
# These are consumed by mcp/ssh_probe.py, which the notify agent may call to
# report SSH status per host. The probe only connects to hosts that are both in
# SSH_ALLOWED_HOSTS and inside the selected target's host_scope.
#
# The key is a single unprivileged private key, mounted read-only, exactly like
# the Oracle wallet. compose.yaml mounts the host file at /ssh/id_ed25519 and
# sets SSH_KEY_PATH to that container path. On the host, put the key outside
# the repository (for example /srv/notify-agent/ssh/id_ed25519), make it
# readable by uid 10001, and point SSH_KEY_HOST_FILE at it in the shell or in
# .env beside compose.yaml:
#   SSH_KEY_HOST_FILE=/srv/notify-agent/ssh/id_ed25519
# SSH_KEY_HOST_FILE is Compose interpolation, not a container variable, so it
# does not belong in this file. Never commit the key or bake it into the image.
SSH_USER=
SSH_KEY_PATH=/ssh/id_ed25519
# Global allowlist. Entries cover themselves and their subdomains. The default
# mirrors the old host report's HOST_REPORT_HOSTS.
SSH_ALLOWED_HOSTS=host1.example.com,host2.example.com,host3.example.com
# Per-host connection and whole-call deadlines, in seconds.
SSH_TIMEOUT_SECONDS=5
SSH_TOTAL_TIMEOUT_SECONDS=20
SSH_PORT=22

# Ordered known-host list for the morning digest. Known hosts get a line even
# when they sent no samples; any other host found in the data follows in name
# order. run-prompt.sh filters this list to the selected target's host_scope
# and carries it into the instruction, because the agent cannot read the
# environment. The default mirrors the old host report.
HOST_REPORT_HOSTS=host1.example.com,host2.example.com,host3.example.com

# IANA timezone read by supercronic for the crontab. Defaults to UTC.
TZ=UTC

# The schedule file is NOT configured here. Compose interpolation happens
# before env_file is read, so stack.env cannot change the mount. Set
# SCHEDULES_FILE in the shell or in a .env file next to compose.yaml instead:
#   SCHEDULES_FILE=/srv/notify-agent/crontab
# The default is ./crontab from the stack directory. See README
# "Add a schedule".
