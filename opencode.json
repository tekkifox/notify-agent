{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "agent": {
    "notify": {
      "description": "Composes one notification and sends it through notify.sh. No other tools.",
      "mode": "primary",
      "steps": 6,
      "prompt": "{file:./prompts/notify.md}",
      "permission": {
        "*": "deny",
        "read": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "task": "deny",
        "todowrite": "deny",
        "question": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": "deny",
        "lsp": "deny",
        "external_directory": "deny",
        "doom_loop": "deny",
        "bash": {
          "*": "deny",
          "/app/scripts/notify.sh -m *": "allow",
          "/app/scripts/notify.sh -t * -m *": "allow"
        }
      }
    }
  }
}
