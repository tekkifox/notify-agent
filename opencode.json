{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "permissions": [
    {
      "action": "oracle_query",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "oracle_search_content",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "ssh_probe",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "bookstack_search",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "bookstack_read",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "oracle": {
        "type": "local",
        "command": ["python3", "/app/mcp/oracle_query.py"],
        "codemode": false,
        "timeout": {
          "startup": 60000,
          "execution": 60000
        },
        "environment": {
          "ORACLE_USER": "{env:ORACLE_USER}",
          "ORACLE_PASSWORD": "{env:ORACLE_PASSWORD}",
          "ORACLE_DSN": "{env:ORACLE_DSN}",
          "ORACLE_WALLET_DIR": "{env:ORACLE_WALLET_DIR}",
          "PYTHONPATH": "/opt/mcp-python",
          "PYTHONUNBUFFERED": "1"
        }
      },
      "ssh": {
        "type": "local",
        "command": ["python3", "/app/mcp/ssh_probe.py"],
        "codemode": false,
        "timeout": {
          "startup": 60000,
          "execution": 60000
        },
        "environment": {
          "SSH_USER": "{env:SSH_USER}",
          "SSH_KEY_PATH": "{env:SSH_KEY_PATH}",
          "SSH_ALLOWED_HOSTS": "{env:SSH_ALLOWED_HOSTS}",
          "SSH_TIMEOUT_SECONDS": "{env:SSH_TIMEOUT_SECONDS}",
          "SSH_TOTAL_TIMEOUT_SECONDS": "{env:SSH_TOTAL_TIMEOUT_SECONDS}",
          "SSH_PORT": "{env:SSH_PORT}",
          "NOTIFY_HOST_SCOPE": "{env:NOTIFY_HOST_SCOPE}",
          "PYTHONPATH": "/opt/mcp-python",
          "PYTHONUNBUFFERED": "1"
        }
      },
      "bookstack": {
        "type": "local",
        "command": ["python3", "/app/mcp/bookstack.py"],
        "codemode": false,
        "timeout": {
          "startup": 60000,
          "execution": 60000
        },
        "environment": {
          "BOOKSTACK_URL": "{env:BOOKSTACK_URL}",
          "BOOKSTACK_TOKEN_ID": "{env:BOOKSTACK_TOKEN_ID}",
          "BOOKSTACK_TOKEN_SECRET": "{env:BOOKSTACK_TOKEN_SECRET}",
          "BOOKSTACK_ALLOWED_BOOKS": "{env:BOOKSTACK_ALLOWED_BOOKS}",
          "BOOKSTACK_TIMEOUT_SECONDS": "{env:BOOKSTACK_TIMEOUT_SECONDS}",
          "NOTIFY_RUNBOOKS_ALLOWED": "{env:NOTIFY_RUNBOOKS_ALLOWED}",
          "NOTIFY_CONTENT_DISABLED": "{env:NOTIFY_CONTENT_DISABLED}",
          "PYTHONPATH": "/opt/mcp-python",
          "PYTHONUNBUFFERED": "1"
        }
      }
    }
  },
  "agent": {
    "notify": {
      "description": "Composes one notification and sends it through notify.sh. Read-only Oracle, SSH health and runbook documentation tools only.",
      "mode": "primary",
      "steps": 12,
      "prompt": "{file:./prompts/notify.md}",
      "permission": {
        "*": "deny",
        "read": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "task": "deny",
        "todowrite": "deny",
        "question": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": "deny",
        "lsp": "deny",
        "external_directory": "deny",
        "doom_loop": "deny",
        "opencode_list_mcp_resources": "deny",
        "opencode_read_mcp_resource": "deny",
        "oracle_query": "allow",
        "oracle_search_content": "allow",
        "ssh_probe": "allow",
        "bookstack_search": "allow",
        "bookstack_read": "allow",
        "bash": {
          "*": "deny",
          "/app/scripts/notify.sh -m *": "allow",
          "/app/scripts/notify.sh -t * -m *": "allow",
          "/bin/sleep 5": "allow"
        }
      }
    }
  }
}
